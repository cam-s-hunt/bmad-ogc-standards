# Pinned pointers to upstream repositories. Nothing is cloned by default.
# Fetch one:  git submodule update --init --depth 1 docs/references/git/<name>
# These are links, not copies: upstream licences differ (see docs/references/REFERENCES.md).

[submodule "opengeospatial-ogcapi-connected-systems"]
	path = docs/references/git/opengeospatial-ogcapi-connected-systems
	url = https://github.com/opengeospatial/ogcapi-connected-systems
	shallow = true

